{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Last1 Panel",
  "mainBinaryName": "last1-panel",
  "version": "0.1.0",
  "identifier": "fun.last1.panel",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Last1 Panel",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#0A0C10"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "shortDescription": "Réglages GPU et écran pour jouer sous Linux",
    "icon": ["icons/icon.png"]
  }
}
