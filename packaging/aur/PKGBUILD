# Maintainer: Last1 <contact@last1.fun>
# Paquet AUR last1-panel-bin, poussé par la CI (packaging/aur/publish.sh) à
# chaque nouvelle version : binaires de la release GitHub, compilés une fois par
# la CI depuis packaging/arch/PKGBUILD. pkgver et sha256sums sont remplis par
# publish.sh.
pkgname=last1-panel-bin
_pkgname=last1-panel
pkgver=0.1.0
pkgrel=1
pkgdesc="GPU and display settings for Linux gaming on Wayland: screen colors, vibrance, display modes, GPU tuning, per-game 3D settings"
arch=('x86_64')
url="https://last1.fun/last1-panel"
license=('GPL-3.0-or-later' 'MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'lcms2' 'hicolor-icon-theme' 'systemd' 'lact')
optdepends=(
  'mangohud: on-screen performance and frame limiter for native games'
  'kscreen: KDE Plasma screen settings (kscreen-doctor)'
)
provides=("$_pkgname")
conflicts=("$_pkgname")
options=('!strip' '!debug')
source=("$_pkgname-$pkgver-x86_64.tar.zst::https://github.com/dexterIshere/last1-panel/releases/download/v$pkgver/$_pkgname-$pkgver-x86_64.tar.zst")
sha256sums=('SKIP')

package() {
  cp -a "$srcdir/usr" "$pkgdir/"
  mv "$pkgdir/usr/share/licenses/$_pkgname" "$pkgdir/usr/share/licenses/$pkgname"
}
